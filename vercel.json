{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "static/**",
          "app/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/styles.css(.*)",
      "dest": "/static/styles.css"
    },
    {
      "src": "/app.js(.*)",
      "dest": "/static/app.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/static/favicon.ico"
    },
    {
      "src": "/favicon.svg",
      "dest": "/static/favicon.svg"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/static/assets/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/",
      "dest": "/static/login.html"
    },
    {
      "src": "/login",
      "dest": "/static/login.html"
    },
    {
      "src": "/login.html",
      "dest": "/static/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/static/index.html"
    },
    {
      "src": "/dashboard.html",
      "dest": "/static/index.html"
    },
    {
      "src": "/main",
      "dest": "/static/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
